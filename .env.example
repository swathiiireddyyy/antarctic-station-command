# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=antarctic_command_super_secret_jwt_key_2026
JWT_EXPIRES_IN=24h

# Database (PostgreSQL - Optional, server falls back to in-memory store if DB is offline)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iari_db
DB_USER=iari_user
DB_PASS=iari_password_2026

# Redis (Optional cache/blacklist)
REDIS_URL=redis://localhost:6379

# Email / Alerts Notification (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_pass

# Frontend URL for CORS (when running decoupled dev server)
FRONTEND_URL=http://localhost:4000
